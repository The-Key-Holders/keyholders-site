# === Secrets layout (this project) ===
# KeePassXC (canonical): C:\Users\javad\vault-staging\lab.kdbx
# Import:  powershell -File C:\Users\javad\Projects\mini_GMKtec_server\scripts\Import-AllSecretsToKeepass.ps1
# Titles:  Brands/Stripe*, Grok/private/XAI, Grok/private/Taskade, Projects/keyholders-site/<KEY>
# Vault (machine-wide fallback):  C:\Users\javad\.env
# Runtime (Next.js):     .env.local  (gitignored; only file Next loads)
# Sync:  pwsh scripts/sync-env-from-home.ps1
# Vercel production: set the same keys in Vercel Project → Settings → Environment Variables
#    (MCP/CLI: vercel env; Ctrl+L panel "ready" = agent MCP connected, not auto-deploy)

# Advisor Tools gate (protects /advisor-tools/*, /psap-allotment, related APIs)
ADVISOR_TOOLS_PASSWORD=change-me-to-a-strong-shared-password

# Neon Postgres — PSAP/Advisor path ops. Schema: db/schema.sql
# DATABASE_URL=postgresql://user:pass@ep-xxx.region.aws.neon.tech/neondb?sslmode=require
# Optional: OPS_STORE=memory (tests) | OPS_STORE_PATH=.data/ops-store.json

# Portal identity / magic links (Slice 2+)
PORTAL_ADMIN_EMAIL=admin@thekeyholders.org
MAGIC_LINK_FROM_EMAIL=admin@thekeyholders.org
# copy = show link in admin UI only | resend = email when RESEND_API_KEY set
MAGIC_LINK_MODE=copy
# RESEND_API_KEY=re_xxx


# Optional legacy Taskade keys (unused by the public Site Guide and Advisor Grok agents)
# TASKADE_API_KEY=tskdp_your_personal_access_token
# TASKADE_ACCESS_TOKEN=tskdp_same_as_above
# TASKADE_SPACE_ID=912rDhsLvyDzJQ5r
# TASKADE_AGENT_ID=01KXFEPH8H7ZSKHPF2H02XKDAB

# xAI — public Site Guide + gated Advisor agents (server-side only, never NEXT_PUBLIC_)
# Create a key at https://console.x.ai. Do not expose the model name in public UI.
XAI_API_KEY=xai-your-key-here
# Optional model override (public Site Guide defaults to grok-4.6 if unset)
# XAI_MODEL=grok-4.6

# Stripe (required for checkout integration)
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_xxxxxxxxxxxxxxxx
STRIPE_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxx
STRIPE_WEBHOOK_SECRET=whsec_xxxxxxxxxxxxxxxx

# Stripe Buy Button IDs (replace placeholders after creating products in Stripe Dashboard)
NEXT_PUBLIC_STRIPE_BUY_BUTTON_DIAGNOSTIC=buy_btn_xxxxxxxx
NEXT_PUBLIC_STRIPE_BUY_BUTTON_HEALTH_CHECK=buy_btn_xxxxxxxx
NEXT_PUBLIC_STRIPE_BUY_BUTTON_QUICK_CONNECT=buy_btn_xxxxxxxx
NEXT_PUBLIC_STRIPE_BUY_BUTTON_INTEGRATION_AUDIT=buy_btn_xxxxxxxx
NEXT_PUBLIC_STRIPE_BUY_BUTTON_USER_TRAINING=buy_btn_xxxxxxxx
NEXT_PUBLIC_STRIPE_BUY_BUTTON_ONGOING_SUPPORT=buy_btn_xxxxxxxx